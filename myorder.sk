# ==========================================================
# ✦ PREMIUM CUSTOM ORDER SYSTEM (COMPLETE FULL SCRIPT) ✦
# ==========================================================

options:
    prefix: &8[&e&lOrder&8] &7

command /order:
    trigger:
        openMainMenu(player, 1)

on load:
    delete {cached::itemtypes::*}
    loop all item types:
        if loop-value is not air:
            add loop-value to {cached::itemtypes::*}

# ---------------------------------------------------------
# ฟังก์ชันสำหรับจัดรูปแบบตัวเลขใส่ลูกน้ำ (เช่น 1,000)
# ---------------------------------------------------------
function formatNum(n: number) :: text:
    set {_s} to "%{_n}%"
    set {_len} to length of {_s}
    if {_len} > 3:
        set {_res} to ""
        set {_c} to 0
        loop {_len} times:
            set {_char} to character at ({_len} - loop-value + 1) of {_s}
            if {_c} is 3:
                set {_res} to ",%{_res}%"
                set {_c} to 0
            set {_res} to "%{_char}%%{_res}%"
            add 1 to {_c}
        return {_res}
    return {_s}

# ---------------------------------------------------------
# 1. หน้าต่าง Main Menu (ตลาดกลางรวมออเดอร์ทุกคน)
# ---------------------------------------------------------
function openMainMenu(p: player, page: integer):
    set {_gui} to chest inventory with 6 rows named "&8✦ &lOrder Menu &8(หน้า %{_page}%)"
    set {_glass} to black stained glass pane named "&7"
    
    loop 9 times:
        set slot loop-number - 1 of {_gui} to {_glass}
        set slot (loop-number - 1) + 45 of {_gui} to {_glass}
    set slot 9, 17, 18, 26, 27, 35, 36 and 44 of {_gui} to {_glass}
    
    set {_sort} to {player::sort::%{_p}'s uuid%}
    if {_sort} is not set:
        set {_sort} to "Newest"
        set {player::sort::%{_p}'s uuid%} to "Newest"

    set {_l1} to "&7▪ NAME (A-Z)"
    set {_l2} to "&7▪ NAME (Z-A)"
    set {_l3} to "&7▪ LOW PRICE"
    set {_l4} to "&7▪ HIGH PRICE"
    set {_l5} to "&7▪ NEWEST"
    set {_l6} to "&7▪ OLDEST"

    if {_sort} is "Name (A-Z)":
        set {_l1} to "&a✔ NAME (A-Z)"
    else if {_sort} is "Name (Z-A)":
        set {_l2} to "&a✔ NAME (Z-A)"
    else if {_sort} is "Low Price":
        set {_l3} to "&a✔ LOW PRICE"
    else if {_sort} is "High Price":
        set {_l4} to "&a✔ HIGH PRICE"
    else if {_sort} is "Newest":
        set {_l5} to "&a✔ NEWEST"
    else if {_sort} is "Oldest":
        set {_l6} to "&a✔ OLDEST"

    delete {_sortLore::*}
    add {_l1} to {_sortLore::*}
    add {_l2} to {_sortLore::*}
    add {_l3} to {_sortLore::*}
    add {_l4} to {_sortLore::*}
    add {_l5} to {_sortLore::*}
    add {_l6} to {_sortLore::*}
    add "" to {_sortLore::*}
    add "&eคลิกเพื่อเปลี่ยนวิธีเรียงลำดับ" to {_sortLore::*}

    set slot 47 of {_gui} to anvil named "&6&l⚡ SORT ⚡" with lore {_sortLore::*}
    set slot 48 of {_gui} to compass named "&b&l🧭 รีเฟรชหน้าจอ" with lore "&7คลิกเพื่อรีเฟรชข้อมูลล่าสุด"
    set slot 49 of {_gui} to map named "&a&l✚ สร้างออเดอร์ใหม่" with lore "&7คลิกเพื่อเลือกไอเทมรับซื้อ (จำกัด 5 อย่าง)"
    set slot 50 of {_gui} to chest named "&d&l📋 ออเดอร์ของคุณ" with lore "&7คลิกเพื่อดูและจัดการออเดอร์ของคุณ"
    set slot 45 of {_gui} to arrow named "&b&l⬅ หน้าก่อนหน้า"
    set slot 53 of {_gui} to arrow named "&b&lหน้าถัดไป ➡"
    
    delete {_activeOrders::*}
    loop {orders::active::*}:
        set {_id} to loop-value
        set {_req} to {order::%{_id}%::amount}
        set {_del} to {order::%{_id}%::delivered}
        
        set {_timeCreated} to {order::%{_id}%::time}
        if {_timeCreated} is not set:
            set {_timeCreated} to now
            set {order::%{_id}%::time} to now
        set {_expireTime} to {_timeCreated}
        add 3 days to {_expireTime}
        
        if {_del} < {_req}:
            if now is less than {_expireTime}:
                add {_id} to {_activeOrders::*}

    delete {_sorted::*}
    if {_sort} is "Newest":
        loop {_activeOrders::*}:
            add loop-value to {_sorted::*}
        set {_sorted::*} to reversed {_sorted::*}
    else if {_sort} is "Oldest":
        loop {_activeOrders::*}:
            add loop-value to {_sorted::*}
    else if {_sort} is "Low Price":
        loop {_activeOrders::*}:
            set {_id} to loop-value
            set {_val} to {order::%{_id}%::price}
            set {_temp::%{_val}%-%{_id}%} to {_id}
        loop sorted indices of {_temp::*}:
            add {_temp::%loop-value%} to {_sorted::*}
    else if {_sort} is "High Price":
        loop {_activeOrders::*}:
            set {_id} to loop-value
            set {_val} to {order::%{_id}%::price}
            set {_temp::%{_val}%-%{_id}%} to {_id}
        loop reversed sorted indices of {_temp::*}:
            add {_temp::%loop-value%} to {_sorted::*}
    else if {_sort} is "Name (A-Z)":
        loop {_activeOrders::*}:
            set {_id} to loop-value
            set {_item_name} to uncolored name of {order::%{_id}%::item}
            set {_temp::%{_item_name}%-%{_id}%} to {_id}
        loop sorted indices of {_temp::*}:
            add {_temp::%loop-value%} to {_sorted::*}
    else if {_sort} is "Name (Z-A)":
        loop {_activeOrders::*}:
            set {_id} to loop-value
            set {_item_name} to uncolored name of {order::%{_id}%::item}
            set {_temp::%{_item_name}%-%{_id}%} to {_id}
        loop reversed sorted indices of {_temp::*}:
            add {_temp::%loop-value%} to {_sorted::*}

    set {_slots::1} to 10
    set {_slots::2} to 11
    set {_slots::3} to 12
    set {_slots::4} to 13
    set {_slots::5} to 14
    set {_slots::6} to 15
    set {_slots::7} to 16
    set {_slots::8} to 19
    set {_slots::9} to 20
    set {_slots::10} to 21
    set {_slots::11} to 22
    set {_slots::12} to 23
    set {_slots::13} to 24
    set {_slots::14} to 25
    set {_slots::15} to 28
    set {_slots::16} to 29
    set {_slots::17} to 30
    set {_slots::18} to 31
    set {_slots::19} to 32
    set {_slots::20} to 33
    set {_slots::21} to 34
    set {_slots::22} to 37
    set {_slots::23} to 38
    set {_slots::24} to 39
    set {_slots::25} to 40
    set {_slots::26} to 41
    set {_slots::27} to 42
    set {_slots::28} to 43

    set {_count} to 0
    set {_start} to ({_page} - 1) * 28
    set {_end} to {_page} * 28
    set {_added} to 0
    
    loop {_sorted::*}:
        add 1 to {_count}
        if {_count} > {_start}:
            if {_count} <= {_end}:
                add 1 to {_added}
                set {_id} to loop-value
                
                set {_displayItem} to {order::%{_id}%::item}
                set {_req} to {order::%{_id}%::amount}
                set {_del} to {order::%{_id}%::delivered}
                set {_price} to {order::%{_id}%::price}
                set {_owner} to {order::%{_id}%::owner_name}
                
                set {_timeCreated} to {order::%{_id}%::time}
                if {_timeCreated} is not set:
                    set {_timeCreated} to now
                    set {order::%{_id}%::time} to now
                set {_expireTime} to {_timeCreated}
                add 3 days to {_expireTime}
                
                set name of {_displayItem} to "&a&lออเดอร์ &8(#%{_id}%)"
                
                delete {_itemLore::*}
                add "&7&m                         &7" to {_itemLore::*}
                add "&7 ❖ ผู้รับซื้อ: &f%{_owner}%" to {_itemLore::*}
                add "&7 ❖ จำนวน: &a%{_del}% &7/ &c%{_req}%" to {_itemLore::*}
                add "&7 ❖ ราคาชิ้นละ: &e%formatNum({_price})%$" to {_itemLore::*}
                
                set {_diff} to difference between now and {_expireTime}
                set {_secs} to {_diff} / 1 second
                if {_secs} is not set:
                    set {_secs} to 0
                set {_hours} to floor({_secs} / 3600)
                set {_rem} to {_secs} - ({_hours} * 3600)
                set {_mins} to floor({_rem} / 60)
                
                set {_timeFormatted} to "%{_hours}% ชั่วโมง %{_mins}% นาที"

                add "&7 ❖ หมดอายุใน: &c%{_timeFormatted}%" to {_itemLore::*}
                add "&7&m                         &7" to {_itemLore::*}
                add "&a&l✔ คลิกเพื่อส่งไอเทม" to {_itemLore::*}
                
                set lore of {_displayItem} to {_itemLore::*}
                
                set {_target_slot} to {_slots::%{_added}%}
                set slot {_target_slot} of {_gui} to {_displayItem}
        if {_count} > {_end}:
            stop loop

    set {gui::main_page::%{_p}'s uuid%} to {_page}
    open {_gui} to {_p}

# ---------------------------------------------------------
# หน้าต่างส่งออเดอร์แบบกล่องใหญ่ 5 แถว (36 ช่องใส่ของ + ปุ่มยืนยัน)
# ---------------------------------------------------------
function openSellChest(p: player, id: integer):
    set {_gui} to chest inventory with 5 rows named "&8✦ &lส่งไอเทมเข้าออเดอร์ &8(#%{_id}%)"
    set {_glass} to black stained glass pane named "&7"
    
    loop 6 times:
        set slot (loop-number - 1) + 36 of {_gui} to {_glass}
    
    set slot 42 of {_gui} to emerald block named "&a&l✔ ยืนยันการส่งไอเทม" with lore "&7คลิกเพื่อส่งไอเทมและรับเงิน"
    set slot 43 of {_gui} to {_glass}
    set slot 44 of {_gui} to barrier named "&c&l✘ ยกเลิก / กลับหน้าแรก"
    
    set {gui::sell_chest_id::%{_p}'s uuid%} to {_id}
    delete {gui::confirmed_sell::%{_p}'s uuid%}
    open {_gui} to {_p}

# ---------------------------------------------------------
# 2. หน้าต่าง "ออเดอร์ของคุณ"
# ---------------------------------------------------------
function openMyOrders(p: player, page: integer):
    set {_gui} to chest inventory with 6 rows named "&8✦ &lออเดอร์ของคุณ &8(หน้า %{_page}%)"
    set {_glass} to black stained glass pane named "&7"
    
    loop 9 times:
        set slot loop-number - 1 of {_gui} to {_glass}
        set slot (loop-number - 1) + 45 of {_gui} to {_glass}
    set slot 9, 17, 18, 26, 27, 35, 36 and 44 of {_gui} to {_glass}
    
    set slot 49 of {_gui} to barrier named "&c&l✘ กลับหน้าแรก"
    set slot 45 of {_gui} to arrow named "&b&l⬅ หน้าก่อนหน้า"
    set slot 53 of {_gui} to arrow named "&b&lหน้าถัดไป ➡"
        
    delete {_myorders::*}
    loop {orders::active::*}:
        set {_id} to loop-value
        if {order::%{_id}%::owner} is {_p}'s uuid:
            add {_id} to {_myorders::*}
            set {_req} to {order::%{_id}%::amount}
            set {_del} to {order::%{_id}%::delivered}
            if {_del} >= {_req}:
                if {order::%{_id}%::notified} is not set:
                    set {order::%{_id}%::notified} to true
                    send "{@prefix}&a🎉 ออเดอร์ #%{_id}% ของคุณมีคนส่งครบจำนวนแล้ว! กดเข้าไปรับของได้เลย" to {_p}

    set {_slots::1} to 10
    set {_slots::2} to 11
    set {_slots::3} to 12
    set {_slots::4} to 13
    set {_slots::5} to 14
    set {_slots::6} to 15
    set {_slots::7} to 16
    set {_slots::8} to 19
    set {_slots::9} to 20
    set {_slots::10} to 21
    set {_slots::11} to 22
    set {_slots::12} to 23
    set {_slots::13} to 24
    set {_slots::14} to 25
    set {_slots::15} to 28
    set {_slots::16} to 29
    set {_slots::17} to 30
    set {_slots::18} to 31
    set {_slots::19} to 32
    set {_slots::20} to 33
    set {_slots::21} to 34
    set {_slots::22} to 37
    set {_slots::23} to 38
    set {_slots::24} to 39
    set {_slots::25} to 40
    set {_slots::26} to 41
    set {_slots::27} to 42
    set {_slots::28} to 43

    set {_count} to 0
    set {_start} to ({_page} - 1) * 28
    set {_end} to {_page} * 28
    set {_added} to 0
    
    loop {_myorders::*}:
        add 1 to {_count}
        if {_count} > {_start}:
            if {_count} <= {_end}:
                add 1 to {_added}
                set {_id} to loop-value
                
                set {_displayItem} to {order::%{_id}%::item}
                set {_req} to {order::%{_id}%::amount}
                set {_del} to {order::%{_id}%::delivered}
                set {_price} to {order::%{_id}%::price}
                
                set name of {_displayItem} to "&a&lจัดการออเดอร์ &8(#%{_id}%)"
                
                delete {_myLore::*}
                add "&7&m                         &7" to {_myLore::*}
                add "&7 ❖ จำนวนที่สั่ง: &c%{_req}%" to {_myLore::*}
                add "&7 ❖ ได้รับแล้ว: &a%{_del}%" to {_myLore::*}
                add "&7 ❖ ราคาชิ้นละ: &e%formatNum({_price})%$" to {_myLore::*}
                add "&7&m                         &7" to {_myLore::*}
                if {_del} >= {_req}:
                    add "&a&l✔ ของครบแล้ว! คลิกเพื่อรับของ" to {_myLore::*}
                else:
                    add "&e&lคลิกเพื่อเปิดหน้าจัดการ/รับของ" to {_myLore::*}
                
                set lore of {_displayItem} to {_myLore::*}
                
                set {_target_slot} to {_slots::%{_added}%}
                set slot {_target_slot} of {_gui} to {_displayItem}
        if {_count} > {_end}:
            stop loop

    if size of {_myorders::*} is 0:
        set slot 22 of {_gui} to paper named "&cคุณยังไม่มีออเดอร์รับซื้อ"

    set {gui::my_page::%{_p}'s uuid%} to {_page}
    open {_gui} to {_p}

# ---------------------------------------------------------
# 3. หน้าต่าง "จัดการออเดอร์เดี่ยว"
# ---------------------------------------------------------
function openManageOrder(p: player, id: integer):
    set {_gui} to chest inventory with 6 rows named "&8✦ &lจัดการออเดอร์ &8(#%{_id}%)"
    set {_glass} to black stained glass pane named "&7"
    loop 54 times:
        set slot loop-number - 1 of {_gui} to {_glass}
        
    if {orders::active::*} does not contain {_id}:
        send "&8[&e&lOrder&8] &cออเดอร์นี้ถูกยกเลิกไปแล้ว!" to {_p}
        close {_p}'s inventory
        stop
        
    set {_displayItem} to {order::%{_id}%::item}
    set {_req} to {order::%{_id}%::amount}
    set {_del} to {order::%{_id}%::delivered}
    set {_price} to {order::%{_id}%::price}
    
    set name of {_displayItem} to "&a&lไอเทมที่ได้รับ: &f%{_del}% &e/ &f%{_req}% ชิ้น"
    
    delete {_manageLore::*}
    add "&7(ออเดอร์ #%{_id}% )" to {_manageLore::*}
    set lore of {_displayItem} to {_manageLore::*}
    
    set slot 22 of {_gui} to {_displayItem}
    
    set slot 48 of {_gui} to hopper named "&a&l📥 ดึงของเข้าตัว" with lore "&7คลิกเพื่อรับของเข้าช่องเก็บของ"
    
    set {_currentTakeAmt} to {player::take_amt::%{_p}'s uuid%::%{_id}%}
    if {_currentTakeAmt} is not set:
        set {_currentTakeAmt} to 1

    set {_t1} to "&7▪ 1 ชิ้น"
    set {_t2} to "&7▪ 5 ชิ้น"
    set {_t3} to "&7▪ 32 ชิ้น"
    set {_t4} to "&7▪ 64 ชิ้น"
    set {_t5} to "&7▪ 128 ชิ้น"

    if {_currentTakeAmt} is 1:
        set {_t1} to "&a✔ 1 ชิ้น"
    else if {_currentTakeAmt} is 5:
        set {_t2} to "&a✔ 5 ชิ้น"
    else if {_currentTakeAmt} is 32:
        set {_t3} to "&a✔ 32 ชิ้น"
    else if {_currentTakeAmt} is 64:
        set {_t4} to "&a✔ 64 ชิ้น"
    else if {_currentTakeAmt} is 128:
        set {_t5} to "&a✔ 128 ชิ้น"

    delete {_takeLore::*}
    add {_t1} to {_takeLore::*}
    add {_t2} to {_takeLore::*}
    add {_t3} to {_takeLore::*}
    add {_t4} to {_takeLore::*}
    add {_t5} to {_takeLore::*}
    add "" to {_takeLore::*}
    add "&eคลิกเพื่อเปลี่ยนจำนวนที่จะดึงเข้าตัว" to {_takeLore::*}

    set slot 47 of {_gui} to ghast tear named "&b&l💧 เลือกจำนวนที่จะดึงเข้าตัว" with lore {_takeLore::*}

    set {_currentDropAmt} to {player::drop_amt::%{_p}'s uuid%::%{_id}%}
    if {_currentDropAmt} is not set:
        set {_currentDropAmt} to 1

    set {_d1} to "&7▪ 1 ชิ้น"
    set {_d2} to "&7▪ 5 ชิ้น"
    set {_d3} to "&7▪ 32 ชิ้น"
    set {_d4} to "&7▪ 64 ชิ้น"
    set {_d5} to "&7▪ 128 ชิ้น"

    if {_currentDropAmt} is 1:
        set {_d1} to "&a✔ 1 ชิ้น"
    else if {_currentDropAmt} is 5:
        set {_d2} to "&a✔ 5 ชิ้น"
    else if {_currentDropAmt} is 32:
        set {_d3} to "&a✔ 32 ชิ้น"
    else if {_currentDropAmt} is 64:
        set {_d4} to "&a✔ 64 ชิ้น"
    else if {_currentDropAmt} is 128:
        set {_d5} to "&a✔ 128 ชิ้น"

    delete {_tearLore::*}
    add {_d1} to {_tearLore::*}
    add {_d2} to {_tearLore::*}
    add {_d3} to {_tearLore::*}
    add {_d4} to {_tearLore::*}
    add {_d5} to {_tearLore::*}
    add "" to {_tearLore::*}
    add "&eคลิกเพื่อเปลี่ยนจำนวนที่จะโยน" to {_tearLore::*}

    set slot 51 of {_gui} to ghast tear named "&b&l💧 เลือกจำนวนที่จะโยน" with lore {_tearLore::*}
    
    set slot 50 of {_gui} to dropper named "&c&l📤 โยนของลงพื้น" with lore "&7คลิกเพื่อโยนไอเทมออกจากออเดอร์ลงด้านหน้า"
    
    set slot 49 of {_gui} to barrier named "&c&lยกเลิกออเดอร์นี้ / ปิดรับ" with lore "&7คืนเงินมัดจำส่วนที่เหลือ (สำหรับของที่ยังไม่ได้ส่ง)"
    set slot 45 of {_gui} to arrow named "&b&l⬅ หน้าก่อนหน้า"
    
    set {gui::manage_id::%{_p}'s uuid%} to {_id}
    open {_gui} to {_p}

# ---------------------------------------------------------
# 4. หน้าต่างเลือกไอเทมทั้งหมด
# ---------------------------------------------------------
function openItemSelector(p: player, page: integer, query: text):
    set {_gui} to chest inventory with 6 rows named "&8✦ &lเลือกไอเทม &8(หน้า %{_page}%)"
    
    loop 9 times:
        set slot (loop-number - 1) + 45 of {_gui} to black stained glass pane named "&7"
        
    set slot 45 of {_gui} to arrow named "&b&l⬅ หน้าก่อนหน้า"
    set slot 46 of {_gui} to compass named "&e&l🔍 ค้นหาไอเทม" with lore "&7คลิกเพื่อพิมพ์ชื่อไอเทมในแชท"
    set slot 49 of {_gui} to barrier named "&c&l✘ กลับหน้าแรก"
    set slot 53 of {_gui} to arrow named "&b&lหน้าถัดไป ➡"
    
    delete {_items::*}
    if {_query} is not set:
        loop {cached::itemtypes::*}:
            add loop-value to {_items::*}
    else if {_query} is "":
        loop {cached::itemtypes::*}:
            add loop-value to {_items::*}
    else:
        set {_q} to lowercase {_query}
        loop {cached::itemtypes::*}:
            set {_raw} to lowercase "%loop-value%"
            replace all "minecraft:" with "" in {_raw}
            replace all "_" with " " in {_raw}
            if {_raw} contains {_q}:
                add loop-value to {_items::*}

    set {_count} to 0
    set {_start} to ({_page} - 1) * 45
    set {_end} to {_page} * 45
    set {_added} to 0
    
    loop {_items::*}:
        add 1 to {_count}
        if {_count} > {_start}:
            if {_count} <= {_end}:
                add 1 to {_added}
                set slot {_added} - 1 of {_gui} to loop-value
        
        if {_added} >= 45:
            stop loop
                
    set {gui::sel_page::%{_p}'s uuid%} to {_page}
    set {gui::sel_query::%{_p}'s uuid%} to {_query}
    open {_gui} to {_p}

# ---------------------------------------------------------
# ระบบคลิกในหน้าต่าง GUI ต่างๆ
# ---------------------------------------------------------
on inventory click:
    set {_invName} to uncolored name of event-inventory

    # --- 1. เมนูหลัก ---
    if {_invName} contains "Order Menu":
        cancel event
        if clicked inventory is player's inventory:
            stop
            
        if clicked slot is 45:
            set {_page} to {gui::main_page::%player's uuid%}
            if {_page} is not set:
                set {_page} to 1
            if {_page} > 1:
                openMainMenu(player, {_page} - 1)
            stop
        if clicked slot is 53:
            set {_page} to {gui::main_page::%player's uuid%}
            if {_page} is not set:
                set {_page} to 1
            openMainMenu(player, {_page} + 1)
            stop
            
        if clicked slot is 47:
            set {_curr} to {player::sort::%player's uuid%}
            set {_modes::1} to "Name (A-Z)"
            set {_modes::2} to "Name (Z-A)"
            set {_modes::3} to "Low Price"
            set {_modes::4} to "High Price"
            set {_modes::5} to "Newest"
            set {_modes::6} to "Oldest"
            
            set {_idx} to 1
            loop 6 times:
                if {_modes::%loop-value%} is {_curr}:
                    set {_idx} to loop-value
                    stop loop
            
            if click type is left mouse button:
                add 1 to {_idx}
                if {_idx} > 6:
                    set {_idx} to 1
            else if click type is right mouse button:
                subtract 1 from {_idx}
                if {_idx} < 1:
                    set {_idx} to 6
            
            set {player::sort::%player's uuid%} to {_modes::%{_idx}%}
            set {_page} to {gui::main_page::%player's uuid%}
            if {_page} is not set:
                set {_page} to 1
            openMainMenu(player, {_page})
            stop

        if clicked slot is 48:
            set {_page} to {gui::main_page::%player's uuid%}
            if {_page} is not set:
                set {_page} to 1
            openMainMenu(player, {_page})
            send "{@prefix}&a🔄 รีเฟรชข้อมูลตลาดเรียบร้อย!"
            stop
            
        if clicked slot is 49:
            set {_myActiveCount} to 0
            loop {orders::active::*}:
                if {order::%loop-value%::owner} is player's uuid:
                    add 1 to {_myActiveCount}
            if {_myActiveCount} >= 5:
                send "{@prefix}&cคุณมีออเดอร์รับซื้อครบ 5 รายการแล้ว! ไม่สามารถสร้างเพิ่มได้อีก"
                stop
            openItemSelector(player, 1, "")
            stop
            
        if clicked slot is 50:
            openMyOrders(player, 1)
            stop
            
        set {_name} to uncolored name of event-item
        if {_name} contains "ออเดอร์":
            set {_lore::*} to uncolored lore of event-item
            set {_line} to {_lore::2}
            replace all " ❖ ผู้รับซื้อ: " with "" in {_line}
            
            if {_line} is player's name:
                send "{@prefix}&cคุณไม่สามารถขายของให้ออเดอร์ตัวเองได้!"
                stop
                
            set {_id_raw} to {_name}
            replace all "ออเดอร์ (#" with "" in {_id_raw}
            replace all ")" with "" in {_id_raw}
            set {_id} to {_id_raw} parsed as integer
            
            set {_timeCreated} to {order::%{_id}%::time}
            if {_timeCreated} is not set:
                set {_timeCreated} to now
            set {_expireTime} to {_timeCreated}
            add 3 days to {_expireTime}
            
            if now is greater than or equal to {_expireTime}:
                send "{@prefix}&cออเดอร์นี้หมดอายุแล้ว (เกิน 3 วัน) ไม่สามารถส่งของได้!"
                set {_page} to {gui::main_page::%player's uuid%}
                if {_page} is not set:
                    set {_page} to 1
                openMainMenu(player, {_page})
                stop

            openSellChest(player, {_id})
        stop

    # --- หน้าต่างส่งไอเทมเข้าออเดอร์ (กล่อง 5 แถวพร้อมปุ่มยืนยัน) ---
    else if {_invName} contains "ส่งไอเทมเข้าออเดอร์":
        # ปุ่มยกเลิก (ช่อง 44) คืนของให้ผู้เล่นทันที
        if clicked slot is 44:
            cancel event
            set {gui::confirmed_sell::%player's uuid%} to true
            close player's inventory
            loop 36 times:
                set {_slotIdx} to loop-number - 1
                set {_itemInBox} to slot {_slotIdx} of event-inventory
                if {_itemInBox} is set:
                    if {_itemInBox} is not air:
                        give {_itemInBox} to player
                        set slot {_slotIdx} of event-inventory to air
            set {_page} to {gui::main_page::%player's uuid%}
            if {_page} is not set:
                set {_page} to 1
            openMainMenu(player, {_page})
            stop
            
        # ปุ่มยืนยัน (ช่อง 42) หักเข้าออเดอร์ และคืนส่วนที่ผิดหรือเกิน
        if clicked slot is 42:
            cancel event
            set {gui::confirmed_sell::%player's uuid%} to true
            
            set {_id} to {gui::sell_chest_id::%player's uuid%}
            
            if {orders::active::*} does not contain {_id}:
                send "{@prefix}&cออเดอร์นี้ไม่มีอยู่หรือถูกยกเลิกไปแล้ว!"
                loop 36 times:
                    set {_slotIdx} to loop-number - 1
                    set {_itemInBox} to slot {_slotIdx} of event-inventory
                    if {_itemInBox} is set:
                        if {_itemInBox} is not air:
                            give {_itemInBox} to player
                            set slot {_slotIdx} of event-inventory to air
                close player's inventory
                set {_page} to {gui::main_page::%player's uuid%}
                if {_page} is not set:
                    set {_page} to 1
                openMainMenu(player, {_page})
                stop
                
            set {_item_type} to type of {order::%{_id}%::item}
            set {_req} to {order::%{_id}%::amount}
            set {_del} to {order::%{_id}%::delivered}
            set {_needed} to {_req} - {_del}
            
            if {_needed} <= 0:
                send "{@prefix}&cออเดอร์นี้ได้รับของครบจำนวนไปแล้ว!"
                loop 36 times:
                    set {_slotIdx} to loop-number - 1
                    set {_itemInBox} to slot {_slotIdx} of event-inventory
                    if {_itemInBox} is set:
                        if {_itemInBox} is not air:
                            give {_itemInBox} to player
                            set slot {_slotIdx} of event-inventory to air
                close player's inventory
                set {_page} to {gui::main_page::%player's uuid%}
                if {_page} is not set:
                    set {_page} to 1
                openMainMenu(player, {_page})
                stop

            set {_acceptedTotal} to 0
            
            loop 36 times:
                set {_slotIndex} to loop-number - 1
                set {_itemInSlot} to slot {_slotIndex} of event-inventory
                
                if {_itemInSlot} is set:
                    if {_itemInSlot} is not air:
                        if (type of {_itemInSlot}) is {_item_type}:
                            set {_slotCount} to item amount of {_itemInSlot}
                            
                            if {_acceptedTotal} < {_needed}:
                                set {_spaceLeft} to {_needed} - {_acceptedTotal}
                                
                                if {_slotCount} <= {_spaceLeft}:
                                    add {_slotCount} to {_acceptedTotal}
                                    set slot {_slotIndex} of event-inventory to air
                                else:
                                    add {_spaceLeft} to {_acceptedTotal}
                                    set {_returnCount} to {_slotCount} - {_spaceLeft}
                                    set item amount of {_itemInSlot} to {_returnCount}
                                    give {_itemInSlot} to player
                                    set slot {_slotIndex} of event-inventory to air
                            else:
                                give {_itemInSlot} to player
                                set slot {_slotIndex} of event-inventory to air
                        else:
                            give {_itemInSlot} to player
                            set slot {_slotIndex} of event-inventory to air

            if {_acceptedTotal} > 0:
                add {_acceptedTotal} to {order::%{_id}%::delivered}
                set {_totalEarn} to {_acceptedTotal} * {order::%{_id}%::price}
                add {_totalEarn} to player's balance
                
                set {_formattedEarn} to formatNum({_totalEarn})
                set {_formattedAccepted} to formatNum({_acceptedTotal})
                send "{@prefix}&aส่งไอเทม &f%{_item_type}% &aจำนวน &e%{_formattedAccepted}% &aชิ้นสำเร็จ! ได้รับเงิน &e%{_formattedEarn}%$"

                set {_newDel} to {order::%{_id}%::delivered}
                if {_newDel} >= {_req}:
                    if {order::%{_id}%::notified} is not set:
                        set {order::%{_id}%::notified} to true
                        set {_ownerUUID} to {order::%{_id}%::owner}
                        loop all players:
                            if loop-player's uuid is {_ownerUUID}:
                                send "{@prefix}&a🎉 ออเดอร์ #%{_id}% (&f%{_item_type}%&a) ของคุณมีคนส่งครบจำนวนแล้ว! ไปที่ /order เพื่อรับของได้เลย" to loop-player
            else:
                send "{@prefix}&cไม่มีไอเทมที่ถูกต้องสำหรับออเดอร์นี้ในกล่อง!"

            close player's inventory
            set {_page} to {gui::main_page::%player's uuid%}
            if {_page} is not set:
                set {_page} to 1
            openMainMenu(player, {_page})
            stop

        # ห้ามคลิกช่องกระจกตกแต่ง (36-41 และ 43)
        if clicked slot is between 36 and 43:
            cancel event
            stop

    # --- 2. หน้าต่างเลือกไอเทม ---
    else if {_invName} contains "เลือกไอเทม":
        cancel event
        if clicked inventory is player's inventory:
            stop
            
        set {_page} to {gui::sel_page::%player's uuid%}
        if {_page} is not set:
            set {_page} to 1
        set {_query} to {gui::sel_query::%player's uuid%}
        
        if clicked slot is 49:
            openMainMenu(player, 1)
            stop
            
        if clicked slot is 46:
            close player's inventory
            set {gui::order_chat_mode::%player's uuid%} to "search"
            send " "
            send "{@prefix}&e➤ กรุณาพิมพ์ &bชื่อไอเทม &eที่ต้องการค้นหาลงในแชท (เช่น sand, kelp)"
            send "{@prefix}&c(พิมพ์ cancel เพื่อยกเลิก)"
            stop
            
        if clicked slot is 45:
            if {_page} > 1:
                openItemSelector(player, {_page} - 1, {_query})
            stop
            
        if clicked slot is 53:
            openItemSelector(player, {_page} + 1, {_query})
            stop
            
        if clicked slot is less than 45:
            if event-item is set:
                set {_myActiveCount} to 0
                loop {orders::active::*}:
                    if {order::%loop-value%::owner} is player's uuid:
                        add 1 to {_myActiveCount}
                if {_myActiveCount} >= 5:
                    send "{@prefix}&cคุณมีออเดอร์รับซื้อครบ 5 รายการแล้ว! ไม่สามารถสร้างเพิ่มได้อีก"
                    close player's inventory
                    stop

                set {_item} to 1 of event-item
                close player's inventory
                set {gui::setup_item::%player's uuid%} to "%{_item}%"
                set {gui::order_chat_mode::%player's uuid%} to "amount"
                send " "
                send "{@prefix}&e➤ กรุณาพิมพ์ &bจำนวนชิ้น &eที่ต้องการรับซื้อลงในแชท"
                send "{@prefix}&c(พิมพ์ cancel เพื่อยกเลิก)"
            stop

    # --- 3. หน้าต่างออเดอร์ของคุณ ---
    else if {_invName} contains "ออเดอร์ของคุณ":
        cancel event
        if clicked inventory is player's inventory:
            stop
            
        if clicked slot is 45:
            set {_page} to {gui::my_page::%player's uuid%}
            if {_page} is not set:
                set {_page} to 1
            if {_page} > 1:
                openMyOrders(player, {_page} - 1)
            stop
        if clicked slot is 53:
            set {_page} to {gui::my_page::%player's uuid%}
            if {_page} is not set:
                set {_page} to 1
            openMyOrders(player, {_page} + 1)
            stop
            
        if clicked slot is 49:
            openMainMenu(player, 1)
            stop
            
        set {_name} to uncolored name of event-item
        if {_name} contains "จัดการออเดอร์":
            set {_id_raw} to {_name}
            replace all "จัดการออเดอร์ (#" with "" in {_id_raw}
            replace all ")" with "" in {_id_raw}
            set {_id} to {_id_raw} parsed as integer
            openManageOrder(player, {_id})
        stop

    # --- 4. หน้าต่างจัดการออเดอร์เดี่ยว ---
    else if {_invName} contains "จัดการออเดอร์":
        cancel event
        if clicked inventory is player's inventory:
            stop
            
        set {_id} to {gui::manage_id::%player's uuid%}
        if {_id} is not set:
            stop
            
        if {orders::active::*} does not contain {_id}:
            send "{@prefix}&cออเดอร์นี้ถูกยกเลิกหรือรับของครบไปแล้ว!"
            close player's inventory
            stop
            
        set {_del} to {order::%{_id}%::delivered}
        set {_req} to {order::%{_id}%::amount}
        set {_item_type} to {order::%{_id}%::item}
        
        if clicked slot is 45:
            openMyOrders(player, 1)
            stop
            
        if clicked slot is 47:
            set {_currentTake} to {player::take_amt::%player's uuid%::%{_id}%}
            if {_currentTake} is not set:
                set {_currentTake} to 1
            
            if {_currentTake} is 1:
                set {player::take_amt::%player's uuid%::%{_id}%} to 5
            else if {_currentTake} is 5:
                set {player::take_amt::%player's uuid%::%{_id}%} to 32
            else if {_currentTake} is 32:
                set {player::take_amt::%player's uuid%::%{_id}%} to 64
            else if {_currentTake} is 64:
                set {player::take_amt::%player's uuid%::%{_id}%} to 128
            else:
                set {player::take_amt::%player's uuid%::%{_id}%} to 1
                
            openManageOrder(player, {_id})
            stop

        if clicked slot is 48:
            if {_del} > 0:
                set {_setting} to {player::take_amt::%player's uuid%::%{_id}%}
                if {_setting} is not set:
                    set {_setting} to 1
                
                set {_takeAmount} to {_setting}
                if {_takeAmount} > {_del}:
                    set {_takeAmount} to {_del}
                
                if {_takeAmount} <= 0:
                    send "{@prefix}&cไม่มีไอเทมให้รับ!"
                    stop

                give {_takeAmount} of {_item_type} to player
                subtract {_takeAmount} from {order::%{_id}%::delivered}
                subtract {_takeAmount} from {order::%{_id}%::amount}
                send "{@prefix}&aรับไอเทม &f%{_item_type}% &aจำนวน &e%{_takeAmount}% &aชิ้นเข้าตัวเรียบร้อย!"
                
                if {order::%{_id}%::amount} <= 0:
                    remove {_id} from {orders::active::*}
                    clear {order::%{_id}%::*}
                    send "{@prefix}&aออเดอร์นี้เคลียร์ของเรียบร้อย ปิดรับอัตโนมัติ!"
                    close player's inventory
                    stop
                
                openManageOrder(player, {_id})
            else:
                send "{@prefix}&cไม่มีไอเทมให้รับ!"
            stop
                
        if clicked slot is 51:
            set {_current} to {player::drop_amt::%player's uuid%::%{_id}%}
            if {_current} is not set:
                set {_current} to 1
            
            if {_current} is 1:
                set {player::drop_amt::%player's uuid%::%{_id}%} to 5
            else if {_current} is 5:
                set {player::drop_amt::%player's uuid%::%{_id}%} to 32
            else if {_current} is 32:
                set {player::drop_amt::%player's uuid%::%{_id}%} to 64
            else if {_current} is 64:
                set {player::drop_amt::%player's uuid%::%{_id}%} to 128
            else:
                set {player::drop_amt::%player's uuid%::%{_id}%} to 1
                
            openManageOrder(player, {_id})
            stop

        # โยนของลงพื้นตรงด้านหน้า 1 เมตร
        if clicked slot is 50:
            if {_del} > 0:
                set {_setting} to {player::drop_amt::%player's uuid%::%{_id}%}
                if {_setting} is not set:
                    set {_setting} to 1
                
                set {_dropAmount} to {_setting}
                if {_dropAmount} > {_del}:
                    set {_dropAmount} to {_del}
                
                if {_dropAmount} <= 0:
                    send "{@prefix}&cไม่มีไอเทมให้ดรอป!"
                    stop

                subtract {_dropAmount} from {order::%{_id}%::delivered}
                subtract {_dropAmount} from {order::%{_id}%::amount}
                
                set {_dropLoc} to location 1 meter in front of player
                add 1 to y-coordinate of {_dropLoc}
                drop {_dropAmount} of {_item_type} at {_dropLoc}
                
                send "{@prefix}&aโยนไอเทม &f%{_item_type}% &aจำนวน &e%{_dropAmount}% &aชิ้นลงด้านหน้าเรียบร้อย!"
                
                if {order::%{_id}%::amount} <= 0:
                    remove {_id} from {orders::active::*}
                    clear {order::%{_id}%::*}
                    send "{@prefix}&aออเดอร์นี้เคลียร์ของเรียบร้อย ปิดรับอัตโนมัติ!"
                    close player's inventory
                    stop
                
                openManageOrder(player, {_id})
            else:
                send "{@prefix}&cไม่มีไอเทมให้ดรอป!"
            stop
                
        # ป้องกันการกดยกเลิกออเดอร์ถ้ายังมีของค้างอยู่
        if clicked slot is 49:
            if {_del} > 0:
                send "{@prefix}&cกรุณารับของหรือโยนของที่ค้างอยู่ให้หมดก่อนกดยกเลิกออเดอร์!"
                stop

            remove {_id} from {orders::active::*}
            
            set {_remain} to {_req} - {_del}
            if {_remain} < 0:
                set {_remain} to 0
            set {_refund} to {_remain} * {order::%{_id}%::price}
            
            if {_refund} > 0:
                add {_refund} to player's balance
            
            clear {order::%{_id}%::*}
            send "{@prefix}&cยกเลิกออเดอร์เรียบร้อย คืนเงินมัดจำส่วนที่เหลือ &e%formatNum({_refund})%$"
            close player's inventory
            stop

# ---------------------------------------------------------
# ระบบป้องกันของหายเมื่อผู้เล่นกดปิดหน้าต่าง (ESC) 
# จะคืนของทั้งหมด 100% ถ้าไม่ได้กดยืนยันหรือกากบาท
# ---------------------------------------------------------
on inventory close:
    set {_invName} to uncolored name of event-inventory
    if {_invName} contains "ส่งไอเทมเข้าออเดอร์":
        set {_confirmed} to {gui::confirmed_sell::%player's uuid%}
        delete {gui::confirmed_sell::%player's uuid%}
        
        if {_confirmed} is set:
            stop
            
        loop 36 times:
            set {_slotIndex} to loop-number - 1
            set {_itemInSlot} to slot {_slotIndex} of event-inventory
            if {_itemInSlot} is set:
                if {_itemInSlot} is not air:
                    give {_itemInSlot} to player
                    set slot {_slotIndex} of event-inventory to air

# ---------------------------------------------------------
# ระบบรับค่าผ่านช่องแชท
# ---------------------------------------------------------
on chat:
    set {_mode} to {gui::order_chat_mode::%player's uuid%}
    if {_mode} is set:
        cancel event
        
        if message is "cancel":
            clear {gui::order_chat_mode::%player's uuid%}
            clear {gui::setup_item::%player's uuid%}
            clear {gui::setup_amount::%player's uuid%}
            clear {gui::sell_order_id::%player's uuid%}
            send "{@prefix}&cยกเลิกการทำรายการแล้ว!"
            stop
            
        if {_mode} is "search":
            clear {gui::order_chat_mode::%player's uuid%}
            if message is not set:
                openItemSelector(player, 1, "")
            else if message is "":
                openItemSelector(player, 1, "")
            else:
                openItemSelector(player, 1, lowercase message)
                send "{@prefix}&a🔍 ค้นหา: &e%message%"
                
        else if {_mode} is "amount":
            set {_amt} to message parsed as integer
            if {_amt} is not set:
                send "{@prefix}&cกรุณาพิมพ์เป็น &eตัวเลข &cเท่านั้น!"
                stop
            if {_amt} <= 0:
                send "{@prefix}&cจำนวนต้องมากกว่า 0!"
                stop
                
            set {gui::setup_amount::%player's uuid%} to "%{_amt}%"
            set {gui::order_chat_mode::%player's uuid%} to "price"
            set {_formattedAmt} to formatNum({_amt})
            send "{@prefix}&a✅ จำนวน: &b%{_formattedAmt}% ชิ้น"
            send "{@prefix}&e➤ กรุณาพิมพ์ &6ราคาต่อ 1 ชิ้น &e(ตัวเลข) ลงในแชท"
            send "{@prefix}&c(พิมพ์ cancel เพื่อยกเลิก)"
            
        else if {_mode} is "price":
            set {_price} to message parsed as number
            if {_price} is not set:
                send "{@prefix}&cกรุณาพิมพ์เป็น &eตัวเลข &cเท่านั้น!"
                stop
            if {_price} <= 0:
                send "{@prefix}&cราคาต้องมากกว่า 0!"
                stop
            if {_price} > 1000000000:
                send "{@prefix}&cตั้งราคาสูงสุดได้ไม่เกิน &e1,000,000,000$&c!"
                stop
                
            set {_myActiveCount} to 0
            loop {orders::active::*}:
                if {order::%loop-value%::owner} is player's uuid:
                    add 1 to {_myActiveCount}
            if {_myActiveCount} >= 5:
                send "{@prefix}&cคุณมีออเดอร์รับซื้อครบ 5 รายการแล้ว! ไม่สามารถสร้างเพิ่มได้อีก"
                clear {gui::order_chat_mode::%player's uuid%}
                clear {gui::setup_item::%player's uuid%}
                clear {gui::setup_amount::%player's uuid%}
                stop

            set {_item_str} to {gui::setup_item::%player's uuid%}
            set {_item} to {_item_str} parsed as item type
            set {_amt_str} to {gui::setup_amount::%player's uuid%}
            set {_amt} to {_amt_str} parsed as integer
            
            set {_total} to {_amt} * {_price}
            if player's balance < {_total}:
                set {_formattedTotal} to formatNum({_total})
                send "{@prefix}&cคุณมีเงินไม่พอ! ต้องใช้เงินมัดจำทั้งหมด &e%{_formattedTotal}%$"
                clear {gui::order_chat_mode::%player's uuid%}
                clear {gui::setup_item::%player's uuid%}
                clear {gui::setup_amount::%player's uuid%}
                stop
                
            remove {_total} from player's balance
            
            set {_id} to random integer between 1000 and 9999
            add {_id} to {orders::active::*}
            set {order::%{_id}%::owner} to player's uuid
            set {order::%{_id}%::owner_name} to player's name
            set {order::%{_id}%::item} to {_item}
            set {order::%{_id}%::amount} to {_amt}
            set {order::%{_id}%::delivered} to 0
            set {order::%{_id}%::price} to {_price}
            set {order::%{_id}%::time} to now
            
            set {_formattedAmt} to formatNum({_amt})
            set {_formattedPrice} to formatNum({_price})
            broadcast "{@prefix}&e%player's name% &7รับซื้อ &f%{_item}% &a%{_formattedAmt}% &7ชิ้น (&e%{_formattedPrice}%$/ชิ้น) พิมพ์ &b/order"
            
            clear {gui::order_chat_mode::%player's uuid%}
            clear {gui::setup_item::%player's uuid%}
            clear {gui::setup_amount::%player's uuid%}