# ----------------------------------------------------------
# Part 1: Chat System (Translates [order] into a clickable button)
# ----------------------------------------------------------
options:
    prefix: &8[&e&lOrder&8] &7

on chat:
    if message contains "[order]":
        cancel event
        set {_msg} to message
        replace all "[order]" with "" in {_msg}
        replace all """" with "" in {_msg}
        
        if {_msg} is "":
            set {_msg} to " "
            
        send formatted "&8[&4Order&8] &a%player%&f: %{_msg}% <command:/checkorder %player%><tooltip:&aClick to open active orders of &e%player%>&b&l(order)<reset>" to all players

# ----------------------------------------------------------
# Part 2: Specific Player Order Command (Fetches data from the main system)
# ----------------------------------------------------------
command /checkorder [<text>]:
    trigger:
        if arg-1 is set:
            set {_target} to arg-1
            set {_gui} to chest inventory with 6 rows named "&8✦ &lOrders of: &n%{_target}%"
            set {_glass} to black stained glass pane named "&7"
            
            # Decorate the GUI border with black glass
            loop 9 times:
                set slot loop-number - 1 of {_gui} to {_glass}
                set slot (loop-number - 1) + 45 of {_gui} to {_glass}
            set slot 9, 17, 18, 26, 27, 35, 36 and 44 of {_gui} to {_glass}
            
            set slot 49 of {_gui} to barrier named "&c&l✘ Close Window"
            
            # Search for active orders owned by the target player
            delete {_targetOrders::*}
            loop {orders::active::*}:
                if {order::%loop-value%::owner_name} is {_target}:
                    add loop-value to {_targetOrders::*}
            
            set {_slots::*} to 10, 11, 12, 13, 14, 15, 16, 19, 20, 21, 22, 23, 24, 25, 28, 29, 30, 31, 32, 33, 34, 37, 38, 39, 40, 41, 42 and 43
            
            set {_added} to 0
            loop {_targetOrders::*}:
                add 1 to {_added}
                if {_added} <= 28:
                    set {_id} to loop-value
                    set {_displayItem} to {order::%{_id}%::item}
                    set {_req} to {order::%{_id}%::amount}
                    set {_del} to {order::%{_id}%::delivered}
                    set {_price} to {order::%{_id}%::price}
                    
                    set name of {_displayItem} to "&a&lOrder &8(#%{_id}%)"
                    
                    delete {_itemLore::*}
                    add "&7&m                         &7" to {_itemLore::*}
                    add "&7 ❖ Buyer: &f%{_target}%" to {_itemLore::*}
                    add "&7 ❖ Progress: &a%{_del}% &7/ &c%{_req}%" to {_itemLore::*}
                    add "&7 ❖ Price each: &e%formatNum({_price})%$" to {_itemLore::*}
                    add "&7&m                         &7" to {_itemLore::*}
                    add "&a&l✔ Click to deliver items" to {_itemLore::*}
                    
                    set lore of {_displayItem} to {_itemLore::*}
                    set {_target_slot} to {_slots::%{_added}%}
                    set slot {_target_slot} of {_gui} to {_displayItem}
            
            if size of {_targetOrders::*} is 0:
                set slot 22 of {_gui} to paper named "&cThis player has no active buy orders."
                
            open {_gui} to player
        else:
            send "{@prefix}&cPlease specify a player name!" to player

# ----------------------------------------------------------
# Part 3: Click Management System for Order Inspection GUI
# ----------------------------------------------------------
on inventory click:
    set {_invName} to uncolored name of event-inventory
    # Intercept order inspection GUIs
    if {_invName} contains "Orders of:":
        cancel event
        if clicked inventory is player's inventory:
            stop
            
        if clicked slot is 49:
            close player's inventory
            stop
            
        set {_name} to uncolored name of event-item
        if {_name} contains "Order":
            set {_lore::*} to uncolored lore of event-item
            set {_line} to {_lore::2}
            replace all " ❖ Buyer: " with "" in {_line}
            
            if {_line} is player's name:
                send "{@prefix}&cYou cannot sell items to your own order!" to player
                stop
                
            set {_id_raw} to {_name}
            replace all "Order (#" with "" in {_id_raw}
            replace all ")" with "" in {_id_raw}
            set {_id} to {_id_raw} parsed as integer
            
            # Open the 5-row delivery chest from your main system
            openSellChest(player, {_id})
        stop
